# Your live domain, no trailing slash. Used for canonical URLs, sitemap, Open Graph and structured data.
NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com

# Paste the token from Google Search Console (HTML tag method), optional.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Where quote enquiries are forwarded (Zapier, Make, Google Apps Script, n8n...). Receives JSON via POST.
# If empty, enquiries are only logged on the server and NOT delivered to you.
ENQUIRY_WEBHOOK_URL=
